# Port the API listens on
PORT=5000
# MongoDB connection string. If MongoDB is unreachable the API falls back to
# built-in sample data (read-only, contact messages kept in memory).
MONGODB_URI=mongodb://127.0.0.1:27017/aplimessmenu
# Comma-separated list of allowed browser origins (leave empty to allow all)
CORS_ORIGIN=http://localhost:3000
