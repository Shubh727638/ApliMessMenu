# Leave empty in development (CRA proxies /api to http://localhost:5000).
# Set when the API is hosted on a different domain, e.g. https://api.example.com
REACT_APP_API_URL=
# Auth0 single-page app settings (Allowed Callback/Logout/Web Origins must include your site URL)
REACT_APP_AUTH0_DOMAIN=
REACT_APP_AUTH0_CLIENT_ID=
